let page = "home";
let cards = [];
let first = null;
let second = null;
let pairs = 0;
let wait = 0;

function setup() {
  createCanvas(900, 600);
  resetGame();
}

function draw() {
  textAlign(CENTER);

  if (page == "home") home();
  if (page == "game") game();
  if (page == "win") win();

  if (wait > 0 && millis() > wait) {
    first.open = false;
    second.open = false;
    first = null;
    second = null;
    wait = 0;
  }
}

function gardenBackground() {
  background(48, 78, 58);

  noStroke();

  fill(72, 125, 125);
  ellipse(450, 370, 1050, 520);

  fill(90, 145, 140);
  ellipse(450, 390, 800, 350);

  fill(38, 68, 43);
  ellipse(40, 70, 300, 250);
  ellipse(860, 70, 300, 250);
  ellipse(30, 570, 350, 270);
  ellipse(870, 570, 350, 270);

  fill(55, 95, 55);
  ellipse(100, 100, 180, 130);
  ellipse(800, 100, 180, 130);
  ellipse(90, 520, 200, 150);
  ellipse(810, 520, 200, 150);

  fill(65, 120, 70);
  ellipse(130, 300, 100, 45);
  ellipse(760, 250, 120, 50);
  ellipse(150, 480, 90, 40);
  ellipse(780, 470, 110, 45);

  fill(240, 180, 195);
  ellipse(130, 295, 25);
  ellipse(760, 245, 25);
  ellipse(150, 475, 20);

  fill(245, 210, 120);
  ellipse(130, 295, 8);
  ellipse(760, 245, 8);
  ellipse(150, 475, 7);

  noFill();
  stroke(220, 245, 240, 45);
  strokeWeight(2);

  ellipse(250, 350, 180, 40);
  ellipse(650, 400, 220, 45);
  ellipse(450, 500, 300, 50);

  noStroke();
}

function home() {
  gardenBackground();

  fill(20, 45, 35, 210);
  rect(250, 45, 400, 500, 22);

  fill(255);
  textSize(50);
  textStyle(BOLD);
  text("Quiet Garden", 450, 115);

  fill(220, 230, 210);
  textSize(17);
  textStyle(NORMAL);
  text("Choose a relaxing activity", 450, 150);

  menuButton(300, 200, "Catch Koi");
  menuButton(300, 300, "Stone Holes");
  menuButton(300, 400, "Match Memory");

  fill(220, 230, 210);
  textSize(13);
  text("Relax • Focus • Play", 450, 505);
}

function menuButton(x, y, words) {
  let hover =
    mouseX > x &&
    mouseX < x + 300 &&
    mouseY > y &&
    mouseY < y + 65;

  noStroke();

  if (hover) {
    fill(130, 175, 15);
  } else {
    fill(95, 145, 85);
  }

  rect(x, y, 300, 65, 12);

  fill(255);
  textStyle(BOLD);
  textSize(19);
  text(words, x + 150, y + 40);
}

function game() {
  background(225, 218, 195);

  noStroke();

  fill(195, 210, 180);
  ellipse(80, 80, 230, 180);
  ellipse(820, 530, 280, 210);

  fill(45, 80, 60);
  textStyle(BOLD);
  textSize(34);
  text("Match Memory", 450, 50);

  fill(90);
  textStyle(NORMAL);
  textSize(15);
  text("Find all three matching pairs", 450, 78);

  for (let c of cards) {
    drawCard(c);
  }

  fill(45, 80, 60);
  noStroke();
  rect(365, 530, 170, 45, 10);

  fill(255);
  textStyle(BOLD);
  textSize(17);
  text("Pairs: " + pairs + " / 3", 450, 558);

  fill(45, 80, 60);
  rect(25, 20, 120, 42, 8);

  fill(255);
  textSize(13);
  text("← Home", 85, 46);
}

function drawCard(c) {
  let hover =
    abs(mouseX - c.x) < 65 &&
    abs(mouseY - c.y) < 75;

  if (c.open || c.match) {
    fill(255, 250, 235);
    stroke(190, 165, 135);
    strokeWeight(2);
    rect(c.x - 65, c.y - 75, 130, 150, 15);

    noStroke();

    if (c.name == "Koi") {
      drawKoi(c.x, c.y - 5);
    }

    if (c.name == "Flower") {
      drawFlower(c.x, c.y - 5);
    }

    if (c.name == "Stone") {
      drawStone(c.x, c.y - 5);
    }

    fill(80);
    textStyle(BOLD);
    textSize(13);
    text(c.name, c.x, c.y + 55);
  } else {
    if (hover && wait == 0) {
      fill(60, 105, 85);
    } else {
      fill(40, 75, 62);
    }

    stroke(220, 195, 150);
    strokeWeight(2);
    rect(c.x - 65, c.y - 75, 130, 150, 15);

    fill(235, 210, 165);
    noStroke();
    textSize(38);
    text("✿", c.x, c.y + 10);
  }
}

function drawKoi(x, y) {
  noStroke();

  fill(245);
  ellipse(x, y, 75, 35);

  fill(225, 85, 55);
  ellipse(x - 15, y, 25, 30);
  ellipse(x + 15, y + 3, 20, 22);

  fill(245);
  triangle(
    x - 35, y,
    x - 58, y - 18,
    x - 58, y + 18
  );

  fill(30);
  ellipse(x + 27, y - 6, 5);
}

function drawFlower(x, y) {
  noStroke();
  fill(225, 135, 155);

  ellipse(x, y - 18, 22, 35);
  ellipse(x, y + 18, 22, 35);
  ellipse(x - 18, y, 35, 22);
  ellipse(x + 18, y, 35, 22);

  fill(240, 190, 120);
  ellipse(x, y, 18);
}

function drawStone(x, y) {
  noStroke();

  fill(120, 125, 115);
  ellipse(x, y + 5, 75, 48);

  fill(165, 170, 155);
  ellipse(x - 12, y - 5, 30, 14);
}

function win() {
  gardenBackground();

  fill(20, 45, 35, 215);
  rect(250, 80, 400, 440, 22);

  fill(240, 190, 195);
  textSize(50);
  text("✿", 450, 145);

  fill(255);
  textStyle(BOLD);
  textSize(44);
  text("Great Job!", 450, 205);

  textStyle(NORMAL);
  textSize(19);
  text("You matched all three pairs!", 450, 245);

  menuButton(300, 300, "Play Again");
  menuButton(300, 400, "Back to Home");
}

function mousePressed() {
  if (page == "home") {
    if (
      mouseX > 300 &&
      mouseX < 600 &&
      mouseY > 400 &&
      mouseY < 465
    ) {
      resetGame();
      page = "game";
    }
  }

  else if (page == "game") {
    if (
      mouseX > 25 &&
      mouseX < 145 &&
      mouseY > 20 &&
      mouseY < 62
    ) {
      page = "home";
      return;
    }

    if (wait > 0) return;

    for (let c of cards) {
      if (
        abs(mouseX - c.x) < 65 &&
        abs(mouseY - c.y) < 75 &&
        !c.open &&
        !c.match
      ) {
        c.open = true;

        if (first == null) {
          first = c;
        } else {
          second = c;

          if (first.name == second.name) {
            first.match = true;
            second.match = true;

            pairs++;

            first = null;
            second = null;

            if (pairs == 3) {
              page = "win";
            }
          } else {
            wait = millis() + 800;
          }
        }

        break;
      }
    }
  }

  else if (page == "win") {
    if (
      mouseX > 300 &&
      mouseX < 600 &&
      mouseY > 300 &&
      mouseY < 365
    ) {
      resetGame();
      page = "game";
    }

    else if (
      mouseX > 300 &&
      mouseX < 600 &&
      mouseY > 400 &&
      mouseY < 465
    ) {
      page = "home";
    }
  }
}

function resetGame() {
  let names = shuffle([
    "Koi",
    "Koi",
    "Flower",
    "Flower",
    "Stone",
    "Stone"
  ]);

  cards = [];
  pairs = 0;
  first = null;
  second = null;
  wait = 0;

  for (let i = 0; i < 6; i++) {
    cards.push({
      x: 220 + (i % 3) * 230,
      y: 190 + floor(i / 3) * 210,
      name: names[i],
      open: false,
      match: false
    });
  }
}
