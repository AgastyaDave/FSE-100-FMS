let holes = [];
let stones = [];
let draggedStone = null;

function setup() {
  createCanvas(800, 600);

  // 5 shapes
  let shapes = ['circle', 'square', 'triangle', 'star', 'oval'];

  // 5 stone holes in the water
  let holePositions = [
    { x: 180, y: 150 },
    { x: 380, y: 120 },
    { x: 620, y: 170 },
    { x: 280, y: 290 },
    { x: 520, y: 310 }
  ];

  // Create holes
  for (let i = 0; i < 5; i++) {
    holes.push({
      x: holePositions[i].x,
      y: holePositions[i].y,
      shape: shapes[i]
    });
  }

  // 5 stones in the bottom area
  for (let i = 0; i < 5; i++) {
    stones.push({
      x: 120 + i * 140,
      y: 510,
      shape: shapes[i],
      dragging: false,
      locked: false
    });
  }
}

function draw() {
  // blue water background
  background(40, 130, 220);

  // Bottom area  
  fill(180, 160, 140);
  noStroke();
  rect(400, 500, width, height - 430);

  // 5 stone holes 
  fill(20, 60, 100);
  stroke(10, 40, 70);
  strokeWeight(3);
  
  for (let h of holes) {
    let r = 40;
    
    if (h.shape === 'circle') {
      ellipse(h.x, h.y, r * 2, r * 2);
    } else if (h.shape === 'square') {
      rectMode(CENTER);
      rect(h.x, h.y, r * 1.6, r * 1.6, 4);
    } else if (h.shape === 'triangle') {
      triangle(h.x, h.y - r, h.x - r, h.y + r * 0.8, h.x + r, h.y + r * 0.8);
    } else if (h.shape === 'star') {
      beginShape();
      for (let i = 0; i < 10; i++) {
        let angle = TWO_PI / 10 * i - HALF_PI;
        let radius = (i % 2 === 0) ? r : r * 0.5;
        vertex(h.x + cos(angle) * radius, h.y + sin(angle) * radius);
      }
      endShape(CLOSE);
    } else if (h.shape === 'oval') {
      ellipse(h.x, h.y, r * 2.2, r * 1.3);
    }
  }

  // Update stone positions if being dragged
  for (let s of stones) {
    if (s.dragging && !s.locked) {
      s.x = mouseX;
      s.y = mouseY;
    }
  }

  // 5 stones 
  fill(130, 130, 130);
  stroke(60);
  strokeWeight(2);
  
  for (let s of stones) {
    let r = 38;
    
    if (s.shape === 'circle') {
      ellipse(s.x, s.y, r * 2, r * 2);
    } else if (s.shape === 'square') {
      rectMode(CENTER);
      rect(s.x, s.y, r * 1.6, r * 1.6, 4);
    } else if (s.shape === 'triangle') {
      triangle(s.x, s.y - r, s.x - r, s.y + r * 0.8, s.x + r, s.y + r * 0.8);
    } else if (s.shape === 'star') {
      beginShape();
      for (let i = 0; i < 10; i++) {
        let angle = TWO_PI / 10 * i - HALF_PI;
        let radius = (i % 2 === 0) ? r : r * 0.5;
        vertex(s.x + cos(angle) * radius, s.y + sin(angle) * radius);
      }
      endShape(CLOSE);
    } else if (s.shape === 'oval') {
      ellipse(s.x, s.y, r * 2.2, r * 1.3);
    }
  }
}

// Mouse interaction for dragging and snapping
function mousePressed() {
  for (let s of stones) {
    if (!s.locked && dist(mouseX, mouseY, s.x, s.y) < 30) {
      s.dragging = true;
      draggedStone = s;
      break;
    }
  }
}

function mouseReleased() {
  if (draggedStone) {
    draggedStone.dragging = false;

    // Check if dropped close to its matching hole
    for (let h of holes) {
      if (h.shape === draggedStone.shape) {
        if (dist(draggedStone.x, draggedStone.y, h.x, h.y) < 35) {
          draggedStone.x = h.x; // Snap into place
          draggedStone.y = h.y;
          draggedStone.locked = true;
        }
      }
    }
    
    draggedStone = null;
  }
}
